# raw corpora, tokenizer files, intermediate caches.
# Anchored: an unanchored `data/` would also swallow web/public/data, which is
# generated output but IS committed so the site can be built without the corpora.
/data/

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# node
node_modules/
web/dist/
.vite/

# verification output: screenshots and Lighthouse reports, regenerable
web/scripts/shots/

# os
Thumbs.db
.DS_Store

# Fetched at build time, not committed: the Llama-3 tokenizer is distributed
# under Meta's Community License, and committing it here would be
# redistribution under terms incompatible with this repo's MIT licence.
# See web/scripts/fetch-tokenizers.mjs and NOTICE.md.
web/public/tokenizers/
